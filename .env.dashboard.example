# Optional. If you want the dashboard to ask for a PIN before anyone
# can view it or control your devices from it, copy this file to a
# new file named ".env.dashboard" (same folder as dashboard.py) and
# set your own PIN below.
#
# This is COMPLETELY SEPARATE from the main ".env" file used by
# monitor.py - creating or editing this file never touches your
# Tapo account credentials, and monitor.py never reads it.
#
# If you don't create ".env.dashboard", the dashboard simply opens
# with no PIN required - fine for a private home/office WiFi, but
# worth adding if the dashboard might be reachable by more people
# than just you.

DASHBOARD_PIN=1234
